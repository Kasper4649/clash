name: Broker 券商分流
desc: 富途/老虎/长桥/Topstep 等券商域名走指定策略组

rule-providers:
  Broker:
    type: http
    behavior: classical
    format: yaml
    url: "https://raw.githubusercontent.com/forecho/broker-rules/master/rule/Clash/Broker.yaml"
    path: ./ruleset/Broker.yaml
    interval: 86400

rules:
  - RULE-SET,Broker,HK